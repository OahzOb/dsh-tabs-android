<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!-- The same palette the desktop tab bar uses, so the two clients look like one
	     product rather than two projects. -->
	<color name="bg">#16161A</color>
	<color name="bar">#1D1D22</color>
	<color name="tab">#26262C</color>
	<color name="line">#33333B</color>
	<color name="fg">#E6E6EA</color>
	<color name="dim">#9A9AA4</color>
	<color name="accent">#5B9DFF</color>
	<color name="ok">#4EC97A</color>
	<color name="warn">#E0A33E</color>
	<color name="bad">#E2605E</color>
	<!-- The launcher icon's own two colours live in `drawable/ic_launcher_background.xml`
	     and `drawable/ic_launcher_foreground.xml`, not here: they are drawings, and the
	     shelf in one has to line up with the tabs in the other. -->
</resources>
