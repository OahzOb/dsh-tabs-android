<?xml version="1.0" encoding="utf-8"?>
<resources>
	<!-- The dark half of the palette; `values/colors.xml` is the light half and holds
	     the reasoning for the split and for the contrast floors. These are the values
	     the app shipped with when the shell was dark-only, so a phone in dark mode
	     looks exactly as it did before, with one exception: `on_accent`.

	     `on_accent` used to be `fg` — near-white — which on this light blue is
	       2.05:1: the word CONNECT on the connect button was legible only by shape.
	     Measured off a screenshot of the button (`#6B9BF8` face, `#E6E6EA` label).
	     Dark ink on the same face is 6.6:1, and the accent is light enough in this
	     mode that dark is the only direction with room. -->
	<color name="bg">#16161A</color>
	<color name="bar">#1D1D22</color>
	<color name="line">#33333B</color>
	<color name="fg">#E6E6EA</color>
	<color name="dim">#9A9AA4</color>
	<color name="accent">#5B9DFF</color>
	<color name="on_accent">#16161A</color>
	<color name="ok">#4EC97A</color>
	<color name="warn">#E0A33E</color>
	<color name="bad">#E2605E</color>
</resources>
