<?xml version="1.0" encoding="utf-8"?>
<!--
    Background layer of the adaptive icon: the window's own surface, nothing else.

    It is a flat colour on purpose. A launcher masks this layer with a shape the
    application never sees — circle, squircle, rounded square — and a gradient or an
    edge would be cropped somewhere unpredictable; a flat tile is the one background
    that looks the same under all of them. The value is the DeepSeek Harness desktop
    icon's own tile, read out of its pixels.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
	android:width="108dp"
	android:height="108dp"
	android:viewportWidth="108"
	android:viewportHeight="108">
	<path
		android:fillColor="#FBFBFB"
		android:pathData="M0,0 h108 v108 h-108 z" />
</vector>
