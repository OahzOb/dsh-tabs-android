<?xml version="1.0" encoding="utf-8"?>
<!--
	The window from the desktop app, rearranged for a thumb: the tab bar stays
	visible at the top, the WebView takes everything else. On the desktop the bar is
	also the window chrome, which is why it lives in the title bar there; on a phone
	there is no chrome seat to take, so it is simply the first row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/bg"
	android:orientation="vertical">

	<LinearLayout
		android:id="@+id/bar"
		android:layout_width="match_parent"
		android:layout_height="44dp"
		android:background="@color/bar"
		android:gravity="center_vertical"
		android:orientation="horizontal">

		<HorizontalScrollView
			android:id="@+id/tabScroll"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:scrollbars="none">

			<LinearLayout
				android:id="@+id/tabs"
				android:layout_width="wrap_content"
				android:layout_height="match_parent"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingStart="6dp"
				android:paddingEnd="6dp" />
		</HorizontalScrollView>

		<ImageButton
			android:id="@+id/add"
			android:layout_width="44dp"
			android:layout_height="match_parent"
			android:background="?android:attr/selectableItemBackground"
			android:contentDescription="@string/add_device"
			android:src="@android:drawable/ic_input_add"
			android:tint="@color/dim" />
	</LinearLayout>

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<!--
			One WebView per *running session*, added and removed by MainActivity —
			rather than one WebView whose URL is swapped when the operator changes
			tabs.

			This is the fix for a real complaint: with a single WebView, switching
			between two running tabs necessarily called `loadUrl` with a different
			URL, and the remote Harness is a single-page application, so every switch
			restarted it from zero. The desktop client has always kept one guest per
			tab and only changed which one is visible; this container is that same
			reconciliation, with the views built in code because they come and go.
		-->
		<FrameLayout
			android:id="@+id/webHost"
			android:layout_width="match_parent"
			android:layout_height="match_parent" />

		<ScrollView
			android:id="@+id/panel"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:elevation="4dp"
			android:fillViewport="true">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal"
				android:orientation="vertical"
				android:padding="28dp">

				<TextView
					android:id="@+id/panelTitle"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textColor="@color/fg"
					android:textSize="17sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/panelReason"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:gravity="center_horizontal"
					android:textColor="@color/dim"
					android:textSize="13sp" />

				<Button
					android:id="@+id/panelAction"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					android:text="@string/retry"
					android:visibility="gone" />

				<TextView
					android:id="@+id/panelTranscriptLabel"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="22dp"
					android:text="@string/transcript"
					android:textColor="@color/dim"
					android:textSize="11sp"
					android:visibility="gone" />

				<TextView
					android:id="@+id/panelTranscript"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:background="@color/bar"
					android:fontFamily="monospace"
					android:padding="10dp"
					android:textColor="@color/dim"
					android:textIsSelectable="true"
					android:textSize="10sp"
					android:visibility="gone" />
			</LinearLayout>
		</ScrollView>
	</FrameLayout>
</LinearLayout>
