<?xml version="1.0" encoding="utf-8"?>
<!--
	The window from the desktop app, rearranged for a thumb: the tab bar stays
	visible at the top, the WebView takes everything else. On the desktop the bar is
	also the window chrome, which is why it lives in the title bar there; on a phone
	there is no chrome seat to take, so it is simply the first row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/bg"
	android:orientation="vertical">

	<LinearLayout
		android:id="@+id/bar"
		android:layout_width="match_parent"
		android:layout_height="48dp"
		android:background="@color/bar"
		android:gravity="center_vertical"
		android:orientation="horizontal">

		<HorizontalScrollView
			android:id="@+id/tabScroll"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:scrollbars="none">

			<LinearLayout
				android:id="@+id/tabs"
				android:layout_width="wrap_content"
				android:layout_height="match_parent"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingStart="6dp"
				android:paddingEnd="6dp" />
		</HorizontalScrollView>

		<!-- The update check has its own control rather than hiding in a menu: a
		     sideloaded app has no store to push a new version, and an update nobody
		     can find is the same as no updater at all. -->
		<ImageButton
			android:id="@+id/update"
			android:layout_width="48dp"
			android:layout_height="match_parent"
			android:background="?android:attr/selectableItemBackground"
			android:minHeight="48dp"
			android:contentDescription="@string/check_updates"
			android:src="@android:drawable/ic_popup_sync"
			android:tint="@color/dim" />

		<ImageButton
			android:id="@+id/add"
			android:layout_width="48dp"
			android:layout_height="match_parent"
			android:background="?android:attr/selectableItemBackground"
			android:minHeight="48dp"
			android:contentDescription="@string/add_device"
			android:src="@android:drawable/ic_input_add"
			android:tint="@color/dim" />
	</LinearLayout>

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<!--
			One WebView per *running session*, added and removed by MainActivity —
			rather than one WebView whose URL is swapped when the operator changes
			tabs.

			This is the fix for a real complaint: with a single WebView, switching
			between two running tabs necessarily called `loadUrl` with a different
			URL, and the remote Harness is a single-page application, so every switch
			restarted it from zero. The desktop client has always kept one guest per
			tab and only changed which one is visible; this container is that same
			reconciliation, with the views built in code because they come and go.
		-->
		<FrameLayout
			android:id="@+id/webHost"
			android:layout_width="match_parent"
			android:layout_height="match_parent" />

		<ScrollView
			android:id="@+id/panel"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:elevation="4dp"
			android:fillViewport="true">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_horizontal"
				android:orientation="vertical"
				android:padding="28dp">

				<TextView
					android:id="@+id/panelTitle"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textColor="@color/fg"
					android:textSize="17sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/panelReason"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:gravity="center_horizontal"
					android:textColor="@color/dim"
					android:textSize="13sp" />

				<!-- A tab with no button on it needs its one gesture spelled out, or
				     nobody finds Disconnect. Only worth the space with >1 machine. -->
				<TextView
					android:id="@+id/panelHint"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					android:gravity="center_horizontal"
					android:text="@string/tab_actions_hint"
					android:textColor="@color/dim"
					android:textSize="11sp"
					android:visibility="gone" />

				<Button
					android:id="@+id/panelAction"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					android:text="@string/retry"
					android:visibility="gone" />

				<TextView
					android:id="@+id/panelTranscriptLabel"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="22dp"
					android:text="@string/transcript"
					android:textColor="@color/dim"
					android:textSize="11sp"
					android:visibility="gone" />

				<TextView
					android:id="@+id/panelTranscript"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:background="@color/bar"
					android:fontFamily="monospace"
					android:padding="10dp"
					android:textColor="@color/dim"
					android:textIsSelectable="true"
					android:textSize="10sp"
					android:visibility="gone" />
			</LinearLayout>
		</ScrollView>

		<!--
			The terminal, over the same area the Harness page occupies. It is a sibling
			of `webHost` and `panel` rather than a fourth tab kind, because a phone's tab
			bar has room for machines, not for machines and their terminals: a tab is a
			machine, and its terminal is a view of it. Switching tabs hides this and
			nothing else; the shell channel behind it stays up.

			`terminalWebHost` holds one WebView created in code, exactly as `webHost`
			does for pages: the terminal is an xterm.js page, and it must not be rebuilt
			when the operator looks at another tab and comes back.
		-->
		<LinearLayout
			android:id="@+id/terminalHost"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="@color/bg"
			android:orientation="vertical"
			android:visibility="gone">

			<LinearLayout
				android:id="@+id/terminalBar"
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:background="@color/bar"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:id="@+id/terminalBack"
					android:layout_width="wrap_content"
					android:layout_height="match_parent"
					android:background="?android:attr/selectableItemBackground"
					android:clickable="true"
					android:focusable="true"
					android:gravity="center"
					android:minWidth="56dp"
					android:paddingStart="12dp"
					android:paddingEnd="12dp"
					android:text="@string/terminal_web"
					android:textColor="@color/fg"
					android:textSize="12sp" />

				<TextView
					android:id="@+id/terminalTitle"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:ellipsize="end"
					android:singleLine="true"
					android:textColor="@color/fg"
					android:textSize="13sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/terminalClose"
					android:layout_width="wrap_content"
					android:layout_height="match_parent"
					android:background="?android:attr/selectableItemBackground"
					android:clickable="true"
					android:focusable="true"
					android:gravity="center"
					android:minWidth="56dp"
					android:paddingStart="12dp"
					android:paddingEnd="12dp"
					android:text="@string/terminal_close"
					android:textColor="@color/fg"
					android:textSize="12sp" />
			</LinearLayout>

			<TextView
				android:id="@+id/terminalStatus"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@color/bar"
				android:paddingStart="10dp"
				android:paddingEnd="10dp"
				android:paddingBottom="4dp"
				android:textColor="@color/dim"
				android:textSize="11sp"
				android:visibility="gone" />

			<FrameLayout
				android:id="@+id/terminalWebHost"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1" />

			<!-- The agents the desktop client offers, run on the far side. Only the two
			     that are commands are buttons; the login shell is the terminal itself. -->
			<LinearLayout
				android:id="@+id/terminalPresetBar"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@color/bar"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingStart="6dp"
				android:paddingEnd="6dp">

				<TextView
					android:id="@+id/presetPi"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:background="?android:attr/selectableItemBackground"
					android:clickable="true"
					android:focusable="true"
					android:gravity="center"
					android:minWidth="52dp"
					android:minHeight="44dp"
					android:paddingStart="12dp"
					android:paddingEnd="12dp"
					android:text="@string/preset_pi"
					android:textColor="@color/fg"
					android:textSize="12sp" />

				<TextView
					android:id="@+id/presetOpencode"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:background="?android:attr/selectableItemBackground"
					android:clickable="true"
					android:focusable="true"
					android:gravity="center"
					android:minWidth="52dp"
					android:minHeight="44dp"
					android:paddingStart="12dp"
					android:paddingEnd="12dp"
					android:text="@string/preset_opencode"
					android:textColor="@color/fg"
					android:textSize="12sp" />
			</LinearLayout>

			<!--
				Keys a soft keyboard does not have. The letters go through xterm normally;
				Ctrl latches for the next key, which is how it behaves on a real keyboard.
			-->
			<HorizontalScrollView
				android:id="@+id/terminalKeyBar"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:background="@color/bar"
				android:scrollbars="none">

				<LinearLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="horizontal"
					android:paddingStart="4dp"
					android:paddingEnd="4dp">

					<TextView
						android:id="@+id/keyCtrl"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="?android:attr/selectableItemBackground"
						android:clickable="true"
						android:focusable="true"
						android:gravity="center"
						android:minWidth="48dp"
						android:minHeight="44dp"
						android:paddingStart="8dp"
						android:paddingEnd="8dp"
						android:text="@string/key_ctrl"
						android:textColor="@color/dim"
						android:textSize="12sp" />

					<TextView
						android:id="@+id/keyEsc"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="?android:attr/selectableItemBackground"
						android:clickable="true"
						android:focusable="true"
						android:gravity="center"
						android:minWidth="48dp"
						android:minHeight="44dp"
						android:paddingStart="8dp"
						android:paddingEnd="8dp"
						android:text="@string/key_esc"
						android:textColor="@color/fg"
						android:textSize="12sp" />

					<TextView
						android:id="@+id/keyTab"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="?android:attr/selectableItemBackground"
						android:clickable="true"
						android:focusable="true"
						android:gravity="center"
						android:minWidth="48dp"
						android:minHeight="44dp"
						android:paddingStart="8dp"
						android:paddingEnd="8dp"
						android:text="@string/key_tab"
						android:textColor="@color/fg"
						android:textSize="12sp" />

					<TextView
						android:id="@+id/keyLeft"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="?android:attr/selectableItemBackground"
						android:clickable="true"
						android:focusable="true"
						android:gravity="center"
						android:minWidth="44dp"
						android:minHeight="44dp"
						android:text="@string/key_left"
						android:textColor="@color/fg"
						android:textSize="14sp" />

					<TextView
						android:id="@+id/keyUp"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="?android:attr/selectableItemBackground"
						android:clickable="true"
						android:focusable="true"
						android:gravity="center"
						android:minWidth="44dp"
						android:minHeight="44dp"
						android:text="@string/key_up"
						android:textColor="@color/fg"
						android:textSize="14sp" />

					<TextView
						android:id="@+id/keyDown"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="?android:attr/selectableItemBackground"
						android:clickable="true"
						android:focusable="true"
						android:gravity="center"
						android:minWidth="44dp"
						android:minHeight="44dp"
						android:text="@string/key_down"
						android:textColor="@color/fg"
						android:textSize="14sp" />

					<TextView
						android:id="@+id/keyRight"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="?android:attr/selectableItemBackground"
						android:clickable="true"
						android:focusable="true"
						android:gravity="center"
						android:minWidth="44dp"
						android:minHeight="44dp"
						android:text="@string/key_right"
						android:textColor="@color/fg"
						android:textSize="14sp" />

					<TextView
						android:id="@+id/keyCopy"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="?android:attr/selectableItemBackground"
						android:clickable="true"
						android:focusable="true"
						android:gravity="center"
						android:minWidth="56dp"
						android:minHeight="44dp"
						android:paddingStart="8dp"
						android:paddingEnd="8dp"
						android:text="@string/terminal_copy"
						android:textColor="@color/fg"
						android:textSize="12sp" />

					<TextView
						android:id="@+id/keyPaste"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="?android:attr/selectableItemBackground"
						android:clickable="true"
						android:focusable="true"
						android:gravity="center"
						android:minWidth="56dp"
						android:minHeight="44dp"
						android:paddingStart="8dp"
						android:paddingEnd="8dp"
						android:text="@string/terminal_paste"
						android:textColor="@color/fg"
						android:textSize="12sp" />
				</LinearLayout>
			</HorizontalScrollView>
		</LinearLayout>
	</FrameLayout>
</LinearLayout>
